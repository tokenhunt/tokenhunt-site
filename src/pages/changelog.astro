---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/800.css';

const releases = [
  {
    v: 'unreleased',
    date: null,
    items: [],
    next: [
      'Silent redaction via <code>updatedToolOutput</code> for PostToolUse hooks — the agent never sees the raw value.',
      'Active verification mode — "is this key actually live?"',
      '<code>--file-path</code> flag on <code>scan --stdin</code> for path-based allowlists.',
    ],
  },
  {
    v: '0.1.0',
    date: '2026-10-15',
    items: [
      'Initial release — live on <a href="https://pypi.org/project/token-hunt/">PyPI</a> and the Claude Code plugin marketplace.',
      'Detection core: <strong>48 regex rules</strong> covering 51 providers, bash escape-hatch detector, entropy candidates.',
      'Provider coverage: 11 dev/infra (Z.ai, Anthropic, OpenAI, GitHub, GitLab, Figma, PyPI, npm, Linear, Stripe, Slack) + 34 LLM inference providers (OpenRouter, Groq, Together, Fireworks, xAI, Perplexity, Hugging Face, Cerebras, Replicate, Vercel AI Gateway, NVIDIA NIM, Chutes, Requesty, Novita, Upstage, Baseten, Baidu Qianfan, fal.ai, DashScope, Moonshot Kimi, Mistral, Cohere, Scaleway, SambaNova, Nebius, AI21, OVHcloud, FriendliAI, GMI Cloud, Crusoe, Featherless, DeepInfra, Inference.net, BytePlus) + generic fallbacks for bare-<code>sk-</code> (DeepSeek, StepFun, SiliconFlow, Poe, Qwen) and JWT shapes (MiniMax).',
      'Providers with no publicly documented key format get keyword-gated opaque rules — attribution + rotation URL, not shape confidence. No guessed regexes, ever.',
      'OpenAI rule tightened to the <code>T3BlbkFJ</code> marker — no double-fire with the generic <code>sk-</code> rule.',
      'Claude Code plugin with 6 hook scripts covering 8 detection rows.',
      'CLI peer with <code>scan</code>, <code>list</code>, <code>close</code>, <code>watch</code> commands.',
      'Pattern layering: builtin → <code>~/.token-hunt/patterns.local.toml</code> → <code>./.token-hunt/patterns.local.toml</code>.',
      'Allowlist engine (path-based + fingerprint-based).',
      '<code>rotations.log</code> JSONL store with 72-hour OVERDUE tracking.',
      'Bash escape-hatch detection — the <code>${VAR:+SET}${VAR:-UNSET}</code> bug class no regex scanner sees.',
      '<code>TOKEN_HUNT_DISABLE=1</code> opt-out · <code>TOKEN_HUNT_ALLOW=1</code> one-shot bypass.',
      'Fail-closed: scanner crashes BLOCK with a bypass hint, never silently allow.',
    ],
  },
];
import Seo from "../components/Seo.astro";

const crumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "TokenHunt", "item": "https://tokenhunt.dev/" },
    { "@type": "ListItem", "position": 2, "name": "Changelog", "item": "https://tokenhunt.dev/changelog" }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Changelog — TokenHunt</title>
    <meta name="description" content="Every change to token-hunt, documented. Keep a Changelog format, semantic versioning." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo
      title="Changelog — TokenHunt"
      description="Every change to token-hunt, documented. Keep a Changelog format, semantic versioning."
      url="https://tokenhunt.dev/changelog"
      jsonLd={[crumbSchema]}
    />
    <script is:inline>
      try { if (localStorage.getItem('th-theme') === 'light') document.documentElement.classList.add('light'); } catch {}
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-label="toggle day/night theme">
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
    </button>
    <a class="site-mark" href="/">
      <svg viewBox="0 0 48 48" role="img" aria-label="tokenhunt mark">
        <circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="3.5" />
        <line x1="24" y1="1" x2="24" y2="12" stroke="currentColor" stroke-width="3.5" />
        <line x1="24" y1="36" x2="24" y2="47" stroke="currentColor" stroke-width="3.5" />
        <line x1="1" y1="24" x2="12" y2="24" stroke="currentColor" stroke-width="3.5" />
        <line x1="36" y1="24" x2="47" y2="24" stroke="currentColor" stroke-width="3.5" />
        <circle cx="24" cy="24" r="4.5" fill="currentColor" />
      </svg>
      <span class="cl">home</span>
    </a>

    <main class="container">
      <p class="kicker">changelog</p>
      <h1>Every change, documented.</h1>
      <p class="sub">Keep a Changelog format · semantic versioning · <a href="https://github.com/tokenhunt/token-hunt/blob/main/CHANGELOG.md">raw on GitHub</a></p>

      {releases.map((r) => (
        <section class="release">
          <div class="rel-head">
            <h2>
              {r.v === 'unreleased' ? <span class="unrel">unreleased</span> : <span class="ver">v{r.v}</span>}
              {r.date && <time datetime={r.date}>{r.date}</time>}
            </h2>
          </div>
          <ul>
            {r.items.map((item) => <li set:html={item} />)}
          </ul>
          {r.next && (
            <div class="planned">
              <p class="planned-h">planned next</p>
              <ul class="planned-list">
                {r.next.map((item) => <li set:html={item} />)}
              </ul>
            </div>
          )}
        </section>
      ))}

      <p class="back"><a href="/">← back to tokenhunt.dev</a> · <a href="/docs">docs</a> · <a href="/license">license</a></p>
    </main>

    <!-- ============ footer ============ -->
    <footer class="foot">
      <div class="foot-icons">
        <a href="https://jordannewell.com" rel="noopener"><img src="/n-logo.png" alt="N" class="newell-logo" loading="lazy" /></a>
      </div>
    </footer>

    <style>
      :root {
        --bg: #0C0D10;
        --surface: #121317;
        --border: #1F2126;
        --text: #F4F3EF;
        --muted: #8A8F98;
        --accent: #FF5A1F;
        --alert: #E5484D;
      }
      :root.light {
        --bg: #F7F6F2;
        --surface: #FFFFFF;
        --border: #E3E1DB;
        --text: #15171C;
        --muted: #686D76;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.95rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      ::selection { background: var(--accent); color: var(--bg); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      code {
        font-size: 0.9em;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1em 0.35em;
      }
      a { color: inherit; }
      .container { max-width: 46rem; margin-inline: auto; padding-block: clamp(9rem, 24vh, 13.5rem) 0; padding-inline: clamp(1.25rem, 4vw, 2rem); }

      /* ---- footer N logo (interleaf canonical) ---- */
      body { min-height: 100svh; display: flex; flex-direction: column; }
      .foot { margin-top: auto; padding-top: 96px; padding-bottom: 40px; }
      .foot-icons { display: flex; justify-content: center; }
      .newell-logo { display: block; height: 28px; width: auto; opacity: 0.9; }
      .foot a:hover .newell-logo { opacity: 1; }
      @media (max-width: 640px) {
        .newell-logo { height: 24px; }
      }

      .site-mark {
        position: absolute;
        top: 40px;
        right: clamp(1.5rem, 3.2vw, 3.5rem);
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.6rem;
        text-decoration: none;
      }
      .site-mark svg { width: 120px; height: 120px; color: var(--accent); }
      @media (max-width: 640px) {
        .site-mark { top: 1.5rem; }
        .site-mark svg { width: 56px; height: 56px; }
      }

      /* ---- theme toggle ---- */
      .theme-toggle {
        position: absolute;
        top: 40px;
        left: clamp(1.5rem, 3.2vw, 3.5rem);
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        background: none;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--muted);
        cursor: pointer;
      }
      .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
      .theme-toggle svg { width: 20px; height: 20px; }
      .theme-toggle .sun { display: none; }
      :root.light .theme-toggle .moon { display: none; }
      :root.light .theme-toggle .sun { display: block; }
      @media (max-width: 640px) {
        .theme-toggle { top: 1.5rem; }
      }
      .site-mark .cl {
        font-size: 0.68rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
      }
      .site-mark:hover .cl { color: var(--accent); }

      .kicker {
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        font-weight: 500;
        margin-bottom: 1rem;
      }
      h1 {
        font-size: clamp(1.8rem, 5vw, 2.6rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin-bottom: 0.75rem;
      }
      .sub { color: var(--muted); font-size: 0.85rem; margin-bottom: 4rem; }
      .sub a { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
      .sub a:hover { color: var(--accent); }

      .release { border-top: 1px solid var(--border); padding-block: 2.5rem; }
      .rel-head h2 {
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        display: flex;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 1.25rem;
      }
      .ver { color: var(--accent); }
      .unrel {
        color: var(--bg);
        background: var(--accent);
        padding: 0.1em 0.5em;
        border-radius: 4px;
        font-size: 0.85em;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      time { color: var(--muted); font-weight: 400; font-size: 0.8rem; }
      ul { list-style: none; }
      ul li { padding-left: 1.4rem; position: relative; margin-bottom: 0.6rem; }
      ul li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.65em;
        width: 0.45rem;
        height: 2px;
        background: var(--muted);
      }
      .release li strong { color: var(--accent); font-weight: 700; }

      .planned {
        margin-top: 1.75rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        background: var(--surface);
      }
      .planned-h {
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.7rem;
        font-weight: 500;
        margin-bottom: 0.75rem;
      }
      .planned-list li::before { background: var(--accent); }

      .back { margin-top: 3rem; font-size: 0.85rem; }
      .back a { color: var(--muted); text-decoration: none; }
      .back a:hover { color: var(--accent); }
    </style>
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const light = document.documentElement.classList.toggle('light');
        try { localStorage.setItem('th-theme', light ? 'light' : 'dark'); } catch {}
      });
    </script>
  </body>
</html>
